{
  "rules": [
    {
      "id": "project-upgrades-have-one-entry",
      "comment": "Runtime may invoke upgrades.project.upgrade_project, never individual historical converters. Removing the upgrade package must not require untangling runtime readers or writers.",
      "modules": ["frisket.*"],
      "exclude": ["frisket.upgrades", "frisket.upgrades.*"],
      "forbidden_imports": ["frisket.upgrades.project.*"],
      "reject_unresolved_dynamic": false
    },
    {
      "id": "no-public-to-private-imports",
      "comment": "No module of the public package may import an optional composition package at module level, inside a function, under TYPE_CHECKING, or through a literal dynamic import. Optional packages may import public code; public code must remain independently installable.",
      "modules": [
        "frisket",
        "frisket.*"
      ],
      "exclude": [
        "frisket_composition",
        "frisket_composition.*"
      ],
      "forbidden_imports": [
        "frisket.hosted",
        "frisket.hosted.*",
        "frisket_composition",
        "frisket_composition.*",
        "frisket.composition",
        "frisket.composition.*"
      ],
      "reject_unresolved_dynamic": false
    },
    {
      "id": "base-endpoint-catalog-leaf",
      "modules": [
        "frisket.contracts.http.endpoint_catalog"
      ],
      "allowed_imports": [],
      "allow_stdlib": true,
      "reject_unresolved_dynamic": true
    },
    {
      "id": "plugin-rpc-contract-authority-is-pure",
      "comment": "PLUGIN-01: the versioned plugin RPC authority is schema-only and may depend only on Pydantic, stdlib, and the existing pure WritePlan contract. Process, provider, project, and server/runtime imports belong to PLUGIN-02 or host adapters.",
      "modules": [
        "frisket.contracts.plugin_rpc"
      ],
      "allowed_imports": [
        "pydantic",
        "frisket.contracts.plugin_write_plan"
      ],
      "allow_stdlib": true,
      "reject_unresolved_dynamic": true
    },
    {
      "id": "runner-split-leaves-do-not-import-the-engine",
      "comment": "map_runner split: extracted leaf modules must never re-import the engine, or the split re-fuses. Wildcard over the runner package; only the package facade (__init__) is a legitimate map_runner importer.",
      "modules": ["frisket.engine.runner.*"],
      "exclude": ["frisket.engine.runner", "frisket.engine.runner.map_runner"],
      "forbidden_imports": ["frisket.engine.runner.map_runner"],
      "reject_unresolved_dynamic": true
    },
    {
      "id": "store-split-leaves-do-not-import-the-project-facade",
      "comment": "project.py split: extracted store leaf modules must never re-import the Project facade, or the split re-fuses. Wildcard over the store package; the excludes are the facade itself plus the frozen set of pre-split stores that already take a typed Project (evidence, media_clip, artifact_timeline). New leaf modules get no exclusion — they receive the project duck-typed.",
      "modules": ["frisket.engine.store.*"],
      "exclude": [
        "frisket.engine.store.project",
        "frisket.engine.store.evidence",
        "frisket.engine.store.media_clip",
        "frisket.engine.store.artifact_timeline"
      ],
      "forbidden_imports": ["frisket.engine.store.project"],
      "reject_unresolved_dynamic": true
    },
    {
      "id": "preview-never-imports-execution",
      "comment": "The frisket.preview family is read-only by contract (no receipts, no runs, no job queue, no project writes; see preview/__init__.py). The forbidden set is the receipted execution machinery: the action executor, the job queue, the run engine, the receipt store, and the whole frisket.engine.runner package. No exclude is needed: preview.cluster shares deterministic fingerprint-clustering helpers from the ops layer instead.",
      "modules": [
        "frisket.preview",
        "frisket.preview.*"
      ],
      "forbidden_imports": [
        "frisket.engine.executor",
        "frisket.engine.executor.*",
        "frisket.engine.jobs",
        "frisket.engine.jobs.*",
        "frisket.engine.runner",
        "frisket.engine.runner.*",
        "frisket.engine.receipt_index",
        "frisket.engine.receipt_index.*"
      ],
      "reject_unresolved_dynamic": true
    },
    {
      "id": "engine-does-not-import-server-or-team",
      "comment": "Layer rule: the execution core must not depend on the web/server or team layers.",
      "modules": [
        "frisket.engine",
        "frisket.engine.*"
      ],
      "forbidden_imports": [
        "frisket.server",
        "frisket.server.*",
        "frisket.team",
        "frisket.team.*"
      ],
      "reject_unresolved_dynamic": false
    },
    {
      "id": "local-provider-config-does-not-import-server-or-team",
      "comment": "frisket.local_provider_config holds read-side workspace provider key, local endpoint, models gateway, and search config resolution shared by engine jobs, CLI commands, and server routes. It must not depend on the server or team layers.",
      "modules": [
        "frisket.local_provider_config"
      ],
      "forbidden_imports": [
        "frisket.server",
        "frisket.server.*",
        "frisket.team",
        "frisket.team.*"
      ],
      "reject_unresolved_dynamic": true
    },
    {
      "id": "security-does-not-import-server-or-team",
      "comment": "frisket.security holds envelope encryption primitives shared by the engine credential store, authoring workbench, server, and team. It must not depend on the server or team layers.",
      "modules": [
        "frisket.security",
        "frisket.security.*"
      ],
      "forbidden_imports": [
        "frisket.server",
        "frisket.server.*",
        "frisket.team",
        "frisket.team.*"
      ],
      "reject_unresolved_dynamic": true
    },
    {
      "id": "notifications-core-does-not-import-server",
      "comment": "frisket.notifications holds the candidate builders, the emit/route-planning core, delivery providers and secrets, digest composition and alert projections that engine jobs and server routes share. It must not depend on the server or team layers, or engine producers and delivery jobs would need a layer exception.",
      "modules": [
        "frisket.notifications",
        "frisket.notifications.*"
      ],
      "forbidden_imports": [
        "frisket.server",
        "frisket.server.*",
        "frisket.team",
        "frisket.team.*"
      ],
      "reject_unresolved_dynamic": true
    },
    {
      "id": "feeds-do-not-import-server",
      "comment": "frisket.feeds holds the feed checker registry, the RSS/YouTube/TikTok/CourtListener/API-list checkers and feed health. Engine poll and collection actions use them, so they must not depend on the server or team layers.",
      "modules": [
        "frisket.feeds",
        "frisket.feeds.*"
      ],
      "forbidden_imports": [
        "frisket.server",
        "frisket.server.*",
        "frisket.team",
        "frisket.team.*"
      ],
      "reject_unresolved_dynamic": true
    },
    {
      "id": "exports-do-not-import-server",
      "comment": "frisket.exports holds sheet export planning, row sets, media attachment policy and CSV/JSONL/Parquet rendering. Engine export actions use them, so they must not depend on the server or team layers.",
      "modules": [
        "frisket.exports",
        "frisket.exports.*"
      ],
      "forbidden_imports": [
        "frisket.server",
        "frisket.server.*",
        "frisket.team",
        "frisket.team.*"
      ],
      "reject_unresolved_dynamic": true
    },
    {
      "id": "url-classification-does-not-import-server-team-engine-or-features",
      "comment": "frisket.url_classification holds URL matcher contracts, PSL normalization, first-party matchers, and the matcher registry shared by engine fetch/collection actions, ops, feeds, plugins, and server hints. It must not depend on server, team, engine, or features.",
      "modules": [
        "frisket.url_classification",
        "frisket.url_classification.*"
      ],
      "forbidden_imports": [
        "frisket.server",
        "frisket.server.*",
        "frisket.team",
        "frisket.team.*",
        "frisket.engine",
        "frisket.engine.*",
        "frisket.features",
        "frisket.features.*"
      ],
      "reject_unresolved_dynamic": true
    },
    {
      "id": "engine-does-not-import-features",
      "comment": "Layer rule: the execution core must not depend on the features layer. The exclude list is the frozen set of feature consumers: entity_package (the FollowTheMoney dataset/package adapter), visual_cuts_read, topic_sections_read, temporal_annotations and temporal_finder_provenance (temporal and topic-segmentation adapters), and jobs feeds/alerts and store alerts (alert events and triggers). No other engine module may add such an import.",
      "modules": [
        "frisket.engine",
        "frisket.engine.*"
      ],
      "exclude": [
        "frisket.engine.executor.entity_package",
        "frisket.engine.executor.temporal_annotations",
        "frisket.engine.executor.temporal_finder_provenance",
        "frisket.engine.executor.visual_cuts_read",
        "frisket.engine.executor.topic_sections_read",
        "frisket.engine.jobs.feeds",
        "frisket.engine.jobs.alerts",
        "frisket.engine.store.alerts"
      ],
      "forbidden_imports": [
        "frisket.features",
        "frisket.features.*"
      ],
      "reject_unresolved_dynamic": false
    },
    {
      "id": "ops-does-not-import-server-or-team",
      "comment": "Layer rule: op implementations must not depend on the web/server or team layers.",
      "modules": [
        "frisket.ops",
        "frisket.ops.*"
      ],
      "forbidden_imports": [
        "frisket.server",
        "frisket.server.*",
        "frisket.team",
        "frisket.team.*"
      ],
      "reject_unresolved_dynamic": false
    },
    {
      "id": "store-never-imports-the-web-server",
      "modules": [
        "frisket.engine.store",
        "frisket.engine.store.*"
      ],
      "forbidden_imports": [
        "frisket.server",
        "frisket.server.*"
      ],
      "reject_unresolved_dynamic": false
    },
    {
      "id": "workbench-wire-contracts-never-import-runtime-shared",
      "comment": "Workbench wire-version constants live in the pure workbench contract. Neither that owner nor the generic contracts package may depend on the plugin runtime helper that consumes them.",
      "modules": [
        "frisket.authoring.workbench.contracts",
        "frisket.contracts",
        "frisket.contracts.*"
      ],
      "forbidden_imports": [
        "frisket.authoring.workbench.plugin_runtime_shared"
      ],
      "reject_unresolved_dynamic": false
    },
    {
      "id": "contracts-import-no-service-or-runtime-layer",
      "comment": "The contracts package is the pure wire/schema layer: request/response shapes, action descriptors, and endpoint policy/catalog. It may reference descriptor constants, but never the service/runtime layers that execute work.",
      "modules": [
        "frisket.contracts",
        "frisket.contracts.*"
      ],
      "forbidden_imports": [
        "frisket.server",
        "frisket.server.*",
        "frisket.engine",
        "frisket.engine.*",
        "frisket.ai",
        "frisket.ai.*",
        "frisket.team",
        "frisket.team.*",
        "frisket.authoring.actions",
        "frisket.authoring.actions.*"
      ],
      "reject_unresolved_dynamic": false
    },
    {
      "id": "map-points-service-stays-projection-backend-generic",
      "comment": "The map-points service consumes whatever projection backend the plugin registry provides; it must never re-weld itself to a geo-branded module.",
      "modules": [
        "frisket.server.services.map_points"
      ],
      "forbidden_imports": [
        "frisket.features.geometry",
        "frisket.features.geometry.*"
      ],
      "reject_unresolved_dynamic": false
    },
    {
      "id": "plugins-and-media-never-import-yt-dlp-in-process",
      "comment": "Media acquisition runs the installed yt-dlp dependency out of process (`python -I -m yt_dlp`). No plugin/transport module may re-grow an in-process `import yt_dlp`.",
      "modules": [
        "frisket.plugins",
        "frisket.plugins.*",
        "frisket.ops.media_metadata"
      ],
      "forbidden_imports": [
        "yt_dlp",
        "yt_dlp.*"
      ],
      "reject_unresolved_dynamic": false
    },
    {
      "id": "sdk-never-imports-the-web-server-or-team",
      "comment": "The sdk is the embeddable public surface. It composes executor/contracts/store/ops, but must not depend on the web server or the hosted control plane.",
      "modules": [
        "frisket.sdk",
        "frisket.sdk.*"
      ],
      "forbidden_imports": [
        "frisket.server",
        "frisket.server.*",
        "frisket.team",
        "frisket.team.*"
      ],
      "reject_unresolved_dynamic": false
    },
    {
      "id": "artifact-mutations-belong-to-artifact-pull",
      "comment": "Promotion and removal require the shared artifact lock plus operation-store admission. Read-only cache helpers remain available to consumers.",
      "modules": [
        "frisket",
        "frisket.*"
      ],
      "exclude": [
        "frisket.engine.jobs.artifact_pull"
      ],
      "forbidden_members": [
        "frisket.ai.models.model_cache.promote",
        "frisket.ai.models.model_cache.uninstall",
        "frisket.engine.jobs.model_pull_store.uninstalling_ref"
      ],
      "reject_unresolved_dynamic": false
    },
    {
      "id": "model-process-lifecycle-has-one-owner",
      "comment": "Call the LocalModelServer start/stop/restart commands; never mutate its process handle or drive its private transition machine outside the owner. Other supervised processes retain their own owners.",
      "modules": [
        "frisket",
        "frisket.*"
      ],
      "exclude": [
        "frisket.runtime.model_server"
      ],
      "forbidden_members": [
        "frisket.runtime.model_server._ModelServerLifecycle",
        "frisket.runtime.model_server.LocalModelServer._*"
      ],
      "reject_unresolved_dynamic": false
    },
    {
      "id": "chat-turn-lifecycle-has-one-owner",
      "comment": "Named ProjectQAStore commands own transitions and atomic child terminal projection. Callers must not drive the transition machine or private SQL projection themselves.",
      "modules": [
        "frisket",
        "frisket.*"
      ],
      "exclude": [
        "frisket.engine.store.project_qa"
      ],
      "forbidden_members": [
        "frisket.engine.store.project_qa.AskTurnLifecycle",
        "frisket.engine.store.project_qa._turn_transition",
        "frisket.engine.store.project_qa.ProjectQAStore._finish_research"
      ],
      "reject_unresolved_dynamic": false
    },
    {
      "id": "model-provider-transports-have-finite-owners",
      "comment": "Provider wire adapters belong to the finite model transport owners. Actions, SDK operations and executor orchestration consume admitted model clients; ordinary HTTP actions remain unrestricted by this provider-specific rule.",
      "modules": [
        "frisket",
        "frisket.*"
      ],
      "exclude": [
        "frisket.ai.llm.router",
        "frisket.ai.llm.adapters",
        "frisket.ai.llm.cloud"
      ],
      "forbidden_imports": [
        "frisket.ai.llm.adapters",
        "frisket.ai.llm.cloud",
        "openai",
        "anthropic",
        "google.genai",
        "ollama",
        "pydantic_ai.models.openai",
        "pydantic_ai.models.anthropic",
        "pydantic_ai.models.google",
        "pydantic_ai.providers.openai",
        "pydantic_ai.providers.anthropic",
        "pydantic_ai.providers.google"
      ],
      "forbidden_members": [
        "frisket.ai.llm.adapters",
        "frisket.ai.llm.cloud",
        "openai",
        "anthropic",
        "google.genai",
        "ollama",
        "pydantic_ai.models.openai",
        "pydantic_ai.models.anthropic",
        "pydantic_ai.models.google",
        "pydantic_ai.providers.openai",
        "pydantic_ai.providers.anthropic",
        "pydantic_ai.providers.google"
      ],
      "reject_unresolved_dynamic": false
    },
    {
      "id": "search-provider-transports-have-finite-owners",
      "comment": "Only search composition, the two purchase-owning callers and the research budget wrapper receive the raw SearchService. Research tools consume the admitted search callback; they cannot import a new unaccounted transport.",
      "modules": ["frisket", "frisket.*"],
      "exclude": [
        "frisket.ai.research.search",
        "frisket.local_provider_config",
        "frisket.engine.executor.web_search_read",
        "frisket.server.services.project_qa_runner",
        "frisket.server.services.project_qa_research"
      ],
      "forbidden_members": ["frisket.ai.research.search.SearchService"],
      "reject_unresolved_dynamic": false
    },
    {
      "id": "hosted-service-transports-have-finite-owners",
      "comment": "Raw hosted document/translation adapters belong to the finite purchase-owning transport leaves. New action or orchestration callers must use the admitted capabilities.",
      "modules": ["frisket", "frisket.*"],
      "exclude": [
        "frisket.ops.integrations.translation_engine",
        "frisket.engine.executor.document_convert",
        "frisket.ops.ocr_engines_remote",
        "frisket.ops.opendocrouter"
      ],
      "forbidden_members": [
        "frisket.ops.integrations.deepl.deepl_translate",
        "frisket.ops.integrations.google_translate.google_translate",
        "frisket.ops.integrations.datalab.datalab_ocr",
        "frisket.ops.integrations.datalab.datalab_convert",
        "frisket.ops.integrations.opendocrouter.parse_document"
      ],
      "reject_unresolved_dynamic": false
    },
    {
      "id": "sidecar-raw-transport-is-private",
      "comment": "Public sidecar_post owns purchase admission and recording. Its raw HTTP helper cannot be imported or borrowed by another caller. Status/capability probes and public sidecar types remain available.",
      "modules": [
        "frisket",
        "frisket.*"
      ],
      "exclude": [
        "frisket.ops._sidecar"
      ],
      "forbidden_members": [
        "frisket.ops._sidecar._sidecar_post_transport"
      ],
      "reject_unresolved_dynamic": false
    },
    {
      "id": "local-purchase-policy-belongs-to-composition",
      "comment": "Only deployment composition and the finite standalone model/backend owners select the local/operator policy. An action may not opt itself out of the hosted purchase owner.",
      "modules": [
        "frisket",
        "frisket.*"
      ],
      "exclude": [
        "frisket.execution.purchases",
        "frisket.server.workspace",
        "frisket.engine.jobs.runs",
        "frisket.operability.diagnostics",
        "frisket.cli.doctor",
        "frisket.ai.embeddings.backends",
        "frisket.ai.embeddings.runtime"
      ],
      "forbidden_members": [
        "frisket.execution.purchases.LocalPurchasePolicy",
        "frisket.execution.purchases.LOCAL_PURCHASE_POLICY"
      ],
      "reject_unresolved_dynamic": false
    },
    {
      "id": "model-router-construction-belongs-to-composition",
      "comment": "An action receives an execution-bound client. Constructing an env-key router with an explicit deployment policy belongs only to the existing finite composition/diagnostic owners. Imports used for annotations remain allowed.",
      "modules": [
        "frisket",
        "frisket.*"
      ],
      "exclude": [
        "frisket.ai.llm.router",
        "frisket.server.workspace",
        "frisket.engine.jobs.runs",
        "frisket.operability.diagnostics",
        "frisket.cli.doctor"
      ],
      "forbidden_calls": [
        "frisket.ai.llm.ModelRouter",
        "frisket.ai.llm.router.ModelRouter"
      ],
      "reject_unresolved_dynamic": false
    },
    {
      "id": "operator-credential-values-belong-to-transport-leaves",
      "comment": "Authoring/orchestration cannot newly resolve operator credentials. These exact transport leaves own their complete outbound purchase through execute_purchase. Project-only secrets, credential types and presence checks remain available. This lexical API fence does not inspect arbitrary environment access.",
      "modules": [
        "frisket.actions",
        "frisket.actions.*",
        "frisket.sdk",
        "frisket.sdk.*",
        "frisket.engine.executor",
        "frisket.engine.executor.*",
        "frisket.ops",
        "frisket.ops.*"
      ],
      "exclude": [
        "frisket.engine.executor.document_convert",
        "frisket.engine.executor.decision_read",
        "frisket.engine.executor.geocode_capability",
        "frisket.engine.executor.census_capability",
        "frisket.sdk.ops.transcription.hosted",
        "frisket.ops.ocr_engines_remote",
        "frisket.ops.opendocrouter",
        "frisket.ops.integrations.translation_engine"
      ],
      "forbidden_members": [
        "frisket.credentials.resolve_credential",
        "frisket.credentials.resolve_credential_with_source",
        "frisket.credentials.resolve_credential_for_use"
      ],
      "reject_unresolved_dynamic": false
    },
    {
      "id": "sidecar-credential-values-belong-to-transport-leaves",
      "comment": "Only the sidecar purchase owner and its transcription transport resolve a token-bearing gateway connection. Capability probes and non-secret base-url metadata remain available.",
      "modules": [
        "frisket.actions",
        "frisket.actions.*",
        "frisket.sdk",
        "frisket.sdk.*",
        "frisket.engine.executor",
        "frisket.engine.executor.*",
        "frisket.ops",
        "frisket.ops.*"
      ],
      "exclude": [
        "frisket.ops._sidecar",
        "frisket.sdk.ops.transcription.sidecar"
      ],
      "forbidden_members": [
        "frisket.ops._sidecar.sidecar_token",
        "frisket.ops._sidecar.sidecar_headers",
        "frisket.ops._sidecar.ephemeral_gateway_connection"
      ],
      "reject_unresolved_dynamic": false
    },
    {
      "id": "pydantic-agent-construction-belongs-to-router-bridges",
      "comment": "PydanticAI can infer a raw provider from a model string. Only the four existing router bridges construct Agent; other callers receive admitted model/capability clients. Annotation imports remain allowed.",
      "modules": [
        "frisket",
        "frisket.*"
      ],
      "exclude": [
        "frisket.ai.llm.structured",
        "frisket.ai.research.row_answer",
        "frisket.ops.mcp_extract",
        "frisket.server.services.project_qa_runner"
      ],
      "forbidden_calls": [
        "pydantic_ai.Agent",
        "pydantic_ai.agent.Agent"
      ],
      "reject_unresolved_dynamic": false
    },
    {
      "id": "transcription-connection-belongs-to-hosted-transport",
      "comment": "The router returns connection fields only to the hosted transcription purchase owner. New callers cannot borrow operator credentials through its private helper.",
      "modules": [
        "frisket",
        "frisket.*"
      ],
      "exclude": [
        "frisket.ai.llm.router",
        "frisket.sdk.ops.transcription.hosted"
      ],
      "forbidden_members": [
        "frisket.ai.llm.router._transcription_connection"
      ],
      "reject_unresolved_dynamic": false
    },
    {
      "id": "private-local-model-resolution-belongs-to-router",
      "comment": "The model router no longer hands raw adapters to callers. Its private resolution descriptor remains router-owned; public nonsecret readiness/identity APIs stay available.",
      "modules": [
        "frisket",
        "frisket.*"
      ],
      "exclude": [
        "frisket.ai.llm.router"
      ],
      "forbidden_members": [
        "frisket.ai.llm.router.ModelRouter._resolve_local_model"
      ],
      "reject_unresolved_dynamic": false
    },
    {
      "id": "local-ocr-inference-belongs-to-purchase-facade",
      "comment": "Raw local OCR functions are implementation details of the purchase-owning OcrEngines fa\u00e7ade. Readiness, constants and setup helpers remain available to their existing consumers.",
      "modules": [
        "frisket",
        "frisket.*"
      ],
      "exclude": [
        "frisket.ops.ocr_engines_local",
        "frisket.ops.ocr_engines"
      ],
      "forbidden_members": [
        "frisket.ops.ocr_engines_local.ocr_rapidocr",
        "frisket.ops.ocr_engines_local.run_rapidocr_pool",
        "frisket.ops.ocr_engines_local.ocr_tesseract",
