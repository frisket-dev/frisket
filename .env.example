# Source-build developer Compose environment template. Release installer
# packages carry their own pinned Compose graphs.
#
# Copy this file to `.env` next to docker-compose.yml (`cp .env.example .env`)
# and fill in the values you need, then `docker compose up -d`. Docker Compose
# reads `.env` automatically for substitutions in docker-compose.yml.
#
# =============================================================================
# REQUIRED — set these before your first `docker compose up`
# =============================================================================

# Immutable identity baked into source-built app/worker images. Set this to the
# full 40-hex output of `git rev-parse HEAD`, and refresh it after every checkout
# or pull before rebuilding. Only consulted when Compose actually builds
# (`docker compose build` / `up --build`); left empty it falls back to the
# literal "unknown", and a prebuilt-artifact deploy (FRISKET_IMAGE set, or the
# fallback tag already `docker load`-ed) never reads it at all.
FRISKET_BUILD_SHA=

# Optional immutable image override for the source Compose stack. Leave empty
# to build/use the local `frisket-team:local` fallback.
FRISKET_IMAGE=

# Encrypts org-supplied LLM API keys at rest (src/frisket/security/secrets.py).
# If unset, the app generates a random key and persists it to local disk on
# first use (unique per instance — never a shared in-repo default), which is
# fine for a single-node self-host but WRONG for anything scaled out to
# multiple app/worker replicas (each would generate its own, mutually
# incompatible key) or anywhere the generated key file isn't guaranteed to
# survive a restart. Generate one real value per instance, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
FRISKET_SECRETS_MASTER_KEY=

# Alternative to the inline master key: a persistent key file shared by every
# app/worker replica. Leave both blank for the single-node /data default.
FRISKET_SECRETS_KEY_FILE=

# The public URL this instance is reachable at (used in magic-link emails,
# OAuth redirect URIs). Must be the exact
# origin users load the app from.
FRISKET_BASE_URL=http://localhost:8000

# Display name for this single organization.
FRISKET_ORGANIZATION_NAME=frisket

# Dedicated Postgres run queue. These are required by the
# base Compose provision/migrate services. The admin locator must use the
# `postgres` maintenance database and match POSTGRES_PASSWORD below. The queue
# locator's password becomes the fixed runtime role's password. These defaults
# are for a localhost-only disposable checkout; change both passwords before
# exposing the stack.
FRISKET_DATABASE_ADMIN_URL=postgresql+psycopg://frisket:frisket@db:5432/postgres
FRISKET_RUN_QUEUE_DATABASE_URL=postgresql+psycopg://frisket_run_queue_runtime:frisket@db:5432/frisket_run_queue

# =============================================================================
# OPTIONAL-DEGRADES-GRACEFULLY — the app runs without these; each one just
# turns off a feature or forces a manual workaround.
# =============================================================================

# Resend API key for Watch notifications and digests. Sign-in email uses the
# SMTP settings below instead.
RESEND_API_KEY=

# Sender identity for Resend notifications. Without them: defaults to
# "frisket <onboarding@resend.dev>", which reads as spam to invitees. The
# address must be on a domain you verified in Resend or sends fail.
FRISKET_EMAIL_FROM_ADDRESS=
FRISKET_EMAIL_FROM_NAME=

# Optional sign-in channels. Password setup/login works without either one.
# Magic links require a real SMTP relay and sender; an SMTP username requires
# STARTTLS or implicit SSL. For port 465, set STARTTLS=false and SSL=true.
FRISKET_MAGIC_LINK_ENABLED=false
FRISKET_SMTP_HOST=
FRISKET_SMTP_PORT=587
FRISKET_SMTP_USERNAME=
FRISKET_SMTP_PASSWORD=
FRISKET_SMTP_FROM=
FRISKET_SMTP_STARTTLS=true
FRISKET_SMTP_SSL=false

# Optional OIDC providers keyed by a short provider id. Each value supplies
# issuer/client registration and authorization, token, and JWKS endpoints.
FRISKET_OIDC_PROVIDERS_JSON={}

# Trust forwarding headers only from these comma-separated proxy CIDRs.
# Invalid CIDRs fail startup; blank trusts none.
FRISKET_TRUSTED_PROXY_CIDRS=

# Continuous SQLite replication to S3-compatible object storage
# (litestream.yml, scripts/release/litestream-entrypoint.sh). Without it: the `litestream`
# compose profile is simply not started (opt in with
# `docker compose --profile litestream up -d`) and you are responsible for
# your own backups. LITESTREAM_BUCKET/PREFIX/ENDPOINT/REGION and the
# access-key pair below are only read when that profile is running.
LITESTREAM_BUCKET=
LITESTREAM_PREFIX=prod
LITESTREAM_ENDPOINT=
LITESTREAM_REGION=auto
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=

# BYO LLM provider keys. At least one of these (or per-org keys entered in
# the UI, envelope-encrypted with FRISKET_SECRETS_MASTER_KEY above) is needed
# for AI ops to do anything; frisket runs fine with zero set, it just has no
# model to call. A local server needs no provider key, but it does require an
# explicit OLLAMA_URL (use http://ollama:11434 with the compose profile).
OLLAMA_URL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
CENSUS_API_KEY=

# Optional heavy-model sidecar (sidecar/ — surya, docling, Whisper's larger
# weights, GLiNER, rerank, embeddings). Without it: those recipes fall back to the
# light in-process engines, which work but are slower/lower-quality. Opt in
# with `docker compose --profile models up -d`; FRISKET_MODELS_TOKEN is
# required by that container once you do (it refuses to start anonymous).
FRISKET_MODELS_URL=
FRISKET_MODELS_TOKEN=

# Explicit-confirm-above-$X threshold for model runs. Runs whose estimated cost
# bound is at or under this many USD are covered by the recorded standing consent and start
# without a confirmation prompt; anything above (or unestimable, or leaving
# the machine) gates for explicit confirmation. 0 = always confirm; raising
# it loosens. Read live — no restart needed. Default: 1.
FRISKET_COST_CONSENT_USD=

# Versioned GPU transcription workers behind the sidecar gateway (set on the
# SIDECAR process, not the app): a worker is routable only when its env
# family is present (frisket_models.transcription.config). Example — MOSS:
#   FRISKET_TRANSCRIPTION_MOSS_WORKER_URL=http://moss-worker:8000
#   FRISKET_TRANSCRIPTION_MOSS_WORKER_TOKEN=<worker bearer secret>
# Full VibeVoice-ASR uses the same gateway with an isolated GPU worker:
#   FRISKET_TRANSCRIPTION_VIBEVOICE_ASR_WORKER_URL=http://gpu-worker:9000
#   FRISKET_TRANSCRIPTION_VIBEVOICE_ASR_WORKER_TOKEN=<worker bearer secret>
# See sidecar/workers/vibevoice_asr/README.md for GPU provisioning and setup.
#   (also honored: ..._TOKEN_FILE, ..._TIMEOUT_SECONDS, ..._PROBE_TIMEOUT_SECONDS)
# Hosted deployments wire worker families automatically; self-hosted operators
# set them on their gateway process.

# =============================================================================
# ADVANCED-OPTIONAL — safe to leave unset for a single-VPS or laptop
# self-host; review these settings before exposing an installation.
# =============================================================================

# Google OAuth sign-in / Sheets connections. Skip for magic-link-only auth.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Deck.gl map basemap key (MapTiler or similar). Skip to fall back to the
# keyless OSM default basemap.
FRISKET_MAP_API_KEY=
FRISKET_MAP_TILE_URL_TEMPLATE=
FRISKET_MAP_ATTRIBUTION=

# Image/UI overrides. The image supplies its own static path; a blank value
# keeps that default. Client-error capture is opt-in.
FRISKET_STATIC_DIR=
FRISKET_CLIENT_ERROR_CAPTURE=false

# Source Compose publishes app port 8000 on loopback by default. Set a public
# domain only when enabling the optional `proxy` profile; FRISKET_BASE_URL must
# use the matching https origin.
FRISKET_PUBLISH_HOST=127.0.0.1
FRISKET_PUBLIC_DOMAIN=

# -----------------------------------------------------------------------------
# Postgres control-plane credentials (docker-compose.yml `db` service).
# MUST-CHANGE if you expose this compose stack beyond localhost — the
# frisket/frisket default is a convenience for a first trial run, not a
# secret. The current Compose stack requires Postgres; single-user use is the
# non-Docker `pip install frisket-data` local product. If POSTGRES_PASSWORD changes,
# update FRISKET_TEAM_DATABASE_URL and FRISKET_DATABASE_ADMIN_URL to match.
#
# FRISKET_TEAM_DATABASE_URL is the one authoritative control-plane locator
# read by frisket.team.config.
# docker-compose.yml derives the worker-side FRISKET_DATABASE_URL from it
# (`${FRISKET_TEAM_DATABASE_URL:-...}`), so rotating a credential is a
# ONE-variable edit — change FRISKET_TEAM_DATABASE_URL below and the app's
# control plane, the worker's org-key resolution, and the worker's audit
# writer all follow it automatically. Pointing the two variables at
# DIFFERENT databases is UNSUPPORTED: the worker resolves org provider keys
# and writes audits through FRISKET_DATABASE_URL, so a split scatters one
# logical control plane across two databases. `create_team_app` logs a loud
# warning (never a crash) if both end up set to different values — treat
# that warning as a misconfiguration to converge, not an option to keep.
# -----------------------------------------------------------------------------
POSTGRES_PASSWORD=frisket
FRISKET_TEAM_DATABASE_URL=postgresql+psycopg://frisket:frisket@db:5432/frisket
