{
  "schemaVersion": "frisket.workbench_contract_fixtures.v1",
  "source": "tests/fixtures/workbench_plugin/README.md",
  "cases": [
    {
      "id": "friendly_filters_panel_descriptor",
      "description": "Docked panel can move across legal regions and keep row/evidence capabilities.",
      "rawDescriptor": {
        "schemaVersion": "frisket.workbench.panel.v1",
        "id": "frisket.investigative.panel.friendly_filters",
        "kind": "panel",
        "ownerPluginId": "frisket.core",
        "title": "Entity facets",
        "shortTitle": "Facets",
        "icon": "Tags",
        "tags": ["investigative", "facets"],
        "componentKey": "core.panels.FriendlyFiltersPanel",
        "placements": [
          {"host": "leftSidebar", "mode": "panel", "default": true, "order": 30, "minSize": 240, "defaultSize": 320},
          {"host": "rightInspector", "mode": "panel", "order": 80},
          {"host": "activityRail", "mode": "panel", "order": 30, "chrome": "minimal"}
        ],
        "requires": [
          {"kind": "hostCapability", "id": "host.navigation.openRow"},
          {"kind": "hostCapability", "id": "host.evidence.open", "optional": true}
        ],
        "dataRequirements": [
          {"kind": "activeProject"},
          {"kind": "activeSheet"}
        ],
        "badge": {"source": "hostState", "key": "entityFacetCount", "format": "count"}
      },
      "expectedManifest": {
        "forbiddenRuntimeKeys": ["componentKey"],
        "keptKeys": ["schemaVersion", "id", "kind", "ownerPluginId", "title", "shortTitle", "icon", "tags", "placements", "requires", "dataRequirements", "badge"]
      },
      "expectedResolved": {
        "status": "enabled",
        "activation": "loadAllowed",
        "legalHosts": ["leftSidebar", "rightInspector", "activityRail"]
      }
    },
    {
      "id": "sources_panel_and_source_kind_forms",
      "rawDescriptor": {
        "schemaVersion": "frisket.workbench.panel.v1",
