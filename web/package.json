{
  "name": "@frisket/frontend-host",
  "version": "0.0.0",
  "type": "module",
  "files": [
    "src"
  ],
  "exports": {
    ".": {
      "types": "./src/frontendHost.ts",
      "import": "./src/frontendHost.ts"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "python3 ../scripts/e2e/checklog.py --kind shell --label web-build --shell \"tsc -b && node scripts/build-editions.mjs\"",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "lint": "python3 ../scripts/e2e/checklog.py --kind shell --label web-lint --shell \"eslint . && depcruise src --config .dependency-cruiser.cjs && node scripts/check-substrate-boundaries.mjs\"",
    "depcruise": "python3 ../scripts/e2e/checklog.py --kind shell --label web-depcruise -- depcruise src --config .dependency-cruiser.cjs",
    "check:boundaries": "node scripts/check-substrate-boundaries.mjs",
    "preview": "vite preview",
    "e2e": "playwright test --config playwright/playwright.config.ts",
    "e2e:smoke": "playwright test --config playwright/playwright.smoke.config.ts",
    "e2e:goldens": "playwright test --config playwright/playwright.goldens.config.ts",
    "e2e:ui": "playwright test --ui --config playwright/playwright.config.ts",
    "plugin-contract:e2e": "playwright test --config playwright/playwright.plugin-contract.config.ts",
    "test:edition-dev-entry": "node scripts/test-edition-dev-entry.mjs",
    "test:host-package": "node scripts/test-frontend-host-package.mjs",
    "gallery": "playwright test --config playwright/playwright.gallery.config.ts",
    "doctor": "python3 ../scripts/e2e/checklog.py --kind shell --label web-doctor -- react-doctor . --yes --blocking none --output-dir .react-doctor",
    "doctor:score": "python3 ../scripts/e2e/checklog.py --kind shell --label web-doctor-score -- node scripts/check-react-doctor-score.mjs",
    "doctor:gate": "python3 ../scripts/e2e/checklog.py --kind shell --label web-doctor-gate -- node scripts/check-react-doctor-gate.mjs",
    "doctor:changed": "python3 ../scripts/e2e/checklog.py --kind shell --label web-doctor-changed -- react-doctor . --yes --scope changed --blocking none --no-telemetry"
  },
  "knip": {
    "entry": [
      "src/entries/local.tsx",
      "src/entries/team.tsx",
      "src/main.tsx"
    ]
  },
  "dependencies": {
    "@deck.gl/aggregation-layers": "^9.3.4",
    "@deck.gl/core": "^9.1.0",
    "@deck.gl/geo-layers": "^9.3.4",
    "@deck.gl/layers": "^9.1.0",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@glideapps/glide-data-grid": "^6.0.3",
    "@types/marked": "^4.3.2",
    "@types/pluralize": "^0.0.33",
    "@types/prismjs": "^1.26.6",
    "ajv": "^8.20.0",
    "apache-arrow": "^21.1.0",
    "dompurify": "^3.4.14",
    "lodash": "^4.18.1",
    "lucide-react": "^1.17.0",
    "marked": "^4.3.0",
    "pdfjs-dist": "^6.2.108",
    "pluralize": "^8.0.0",
    "prismjs": "^1.30.0",
    "react-simple-code-editor": "^0.14.1",
    "use-sync-external-store": "^1.6.0"
  },
  "peerDependencies": {
    "@frisket/plugin-sdk": "^0.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^8.0.12"
  },
  "devDependencies": {
    "@frisket/plugin-sdk": "file:../sdk",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.1",
    "dependency-cruiser": "^17.4.3",
    "esbuild": "^0.28.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-doctor": "^0.5.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.10"
  }
}
